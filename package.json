{
  "name": "fuelflow-desktop",
  "version": "1.0.4",
  "description": "FuelFlow Desktop Application",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "itsmebiwash",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.itsmebiwash.fuelflow",
    "productName": "FuelFlow",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true
    },
    "publish": {
      "provider": "github",
      "owner": "itsmebiwash",
      "repo": "Fuelflow-software"
    }
  }
}
